{
  "name": "@bliptrace/express",
  "version": "1.0.0",
  "description": "Express framework adapter for Bliptrace — a thin error-handling middleware over @bliptrace/js that enriches captures with request context and ships them without ever throwing into the host app.",
  "keywords": [
    "bliptrace",
    "express",
    "error-tracking",
    "observability",
    "middleware",
    "sdk"
  ],
  "license": "MIT",
  "author": "Developers Hub Sdn Bhd",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bliptrace/js": "file:../bliptrace-js"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "express": "^4.19.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bliptrace/bliptrace-express.git"
  },
  "homepage": "https://scope.g8suite.com",
  "engines": {
    "node": ">=18"
  }
}
